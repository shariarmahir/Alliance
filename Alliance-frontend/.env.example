# Copy to .env.local and fill in. See SECURITY.md for full setup notes.
# Never commit .env.local — it is gitignored.

# --- Session signing (REQUIRED) -------------------------------------------
# Without this the app refuses to authenticate anyone, by design: an unsigned
# session cookie can be forged, which is the vulnerability this replaced.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# --- Bootstrap super admin ------------------------------------------------
# The owner account, kept out of source. Store the bcrypt hash BASE64-ENCODED,
# not raw — Next's env loader treats a literal $ as a $VAR substitution and
# silently mangles a raw bcrypt string ("$2b$12$..."). See SECURITY.md.
# Generate:
#   node -e "require('bcryptjs').hash('YOUR-PASSWORD',12).then(h=>console.log(Buffer.from(h).toString('base64')))"
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_NAME=""
SUPER_ADMIN_PASSWORD_HASH_B64=""

# --- Vercel Blob storage --------------------------------------------------
# BLOB_PRIVATE must be "true" in production: while false, every business
# record (customer PII, pricing, staff password hashes) is readable by anyone
# with the store hostname. Private access is a store-level setting — see
# SECURITY.md for the migration.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
BLOB_PRIVATE="false"

# --- Transactional email (Resend) -----------------------------------------
# Set RESEND_DOMAIN_VERIFIED="true" once auto-bd.com shows Verified at
# resend.com/domains. While false, no quotation email sends at all.
RESEND_API_KEY=""
RESEND_DOMAIN_VERIFIED="false"
