# Copy to .env.local and fill in. Never commit .env.local — it is gitignored.
#
# This app holds almost no configuration any more: the database, email, object
# storage, Gmail OAuth and the bootstrap super admin all moved to the backend
# (see ../Allaince-backend/.env.example).

# --- Backend location (REQUIRED) ------------------------------------------
# Server components and server actions use API_URL; the browser uses
# NEXT_PUBLIC_API_URL. They differ only when the backend is reachable at a
# different address from inside the server than from a user's browser
# (containers, private networking); otherwise set both the same.
API_URL="http://localhost:8000"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# --- Session signing (REQUIRED) -------------------------------------------
# MUST be byte-identical to the backend's SESSION_SECRET. proxy.ts verifies the
# session JWT locally to decide redirects, so a mismatch rejects every token the
# backend issues and sends the whole admin area to /admin/login — with nothing
# logged anywhere. The symptom is a 307 on every /admin/* page.
SESSION_SECRET=""
