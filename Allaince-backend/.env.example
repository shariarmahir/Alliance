# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------
# Postgres in production. Tests/dev may use sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/allaince

# >= 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-to-a-random-32-plus-char-secret
GMAIL_TOKEN_ENCRYPTION_SECRET=change-me-to-a-random-32-plus-char-secret

# Comma-separated frontend origins allowed to send credentialed requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# "production" enables strict checks (Redis required, secure cookies).
ENVIRONMENT=development

# Cross-origin cookies need SameSite=None; Secure in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Set when frontend and backend share a parent domain, e.g. .auto-bd.com
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Bootstrap super admin (optional; the only account not stored in the DB)
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@example.com
# base64 of a bcrypt hash. Generate:
#   python -c "import bcrypt,base64;print(base64.b64encode(bcrypt.hashpw(b'yourpassword',bcrypt.gensalt(12))).decode())"
SUPER_ADMIN_PASSWORD_HASH_B64=
SUPER_ADMIN_NAME=Super Admin

# ---------------------------------------------------------------------------
# Integrations (optional — each degrades gracefully when unset)
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/admin/emails/oauth/callback

RESEND_API_KEY=
RESEND_FROM_EMAIL=info@auto-bd.com
# Internal address notified on new price requests / contact submissions.
NOTIFY_INTERNAL_EMAIL=info@auto-bd.com

# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO).
# Leave S3_ENDPOINT_URL blank to fall back to local disk under ./media in dev.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET_NAME=allaince-images
S3_PUBLIC_BASE_URL=

# Redis-backed rate limiting. Required in production; falls back to
# in-memory (per-worker, best-effort) when unset in development.
REDIS_URL=

# Public base URL of this API, used to build absolute links in emails/PDFs.
PUBLIC_API_URL=http://localhost:8000
# Public base URL of the storefront, used for tracking links in emails.
PUBLIC_SITE_URL=http://localhost:3000

# Massive (formerly Polygon.io) market data. Free tier: 5 requests/minute,
# US listings only — the Overview tracks the manufacturers via their US ADRs.
# Leave unset to hide the market panel.
MASSIVE_API_KEY=
MARKET_CACHE_HOURS=24

# Shared mailbox, read over IMAP (Namecheap Private Email, cPanel, etc).
# Takes precedence over the Google OAuth settings above when both are present.
# The password grants full mailbox access, so it lives here rather than being
# entered in the admin UI or stored in the database.
IMAP_HOST=mail.privateemail.com
IMAP_PORT=993
IMAP_USERNAME=info@auto-bd.com
IMAP_PASSWORD=
